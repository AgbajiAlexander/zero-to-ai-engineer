# Application
APP_ENV=development
APP_PORT=8080

# Database — direct connection DSN for the Go API (used outside Docker)
DATABASE_URL=postgres://zero_to_ai_engineer:password123@localhost:5432/zero_to_ai_engineer?sslmode=disable

# Database — password used by docker-compose.yml
POSTGRES_PASSWORD=password123

# Authentication — must be at least 32 characters; generate with:
#   openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret-value

# AI
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Frontend origin — the URL of the Next.js application
WEB_ORIGIN=http://localhost:3000
