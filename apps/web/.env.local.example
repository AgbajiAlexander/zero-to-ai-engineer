# apps/web — local environment variables
#
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and must never be committed.
#
# API_ORIGIN is server-only. Never prefix it with NEXT_PUBLIC_.
# The Next.js rewrite in next.config.ts forwards /api/* to this origin,
# so the browser's session cookie stays on the Next.js origin.
#
# For local development the Go API runs on http://localhost:8080 by default.
# Uncomment and set this only if your local API uses a different port.
#
# API_ORIGIN=http://localhost:8080
